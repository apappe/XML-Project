<!ENTITY % urlop "0">
<!ENTITY % biuro "1">
<!ENTITY % zadlnie "2">
<!ENTITY % delegacja "3">
<!ENTITY % outsourcing "4">
<!ENTITY % l4 "5">

<!ELEMENT ewidencja (wpis*)>
	<!ELEMENT wpis (wprowadzajacy, pracownik, typ_aktywnosci, projekt*, data, czas_trwania?)>
		<!ELEMENT wprowadzajacy (imie, nazwisko, pesel, data_urodzenia)>
			<!ATTLIST wprowadzajacy ID_wprowadzajacego NMTOKEN #REQUIRED>
			<!ATTLIST wprowadzajacy is_admin (false|true) 'false'>
			<!ATTLIST wprowadzajacy is_officeworker (false|true) 'false'>
			<!ELEMENT imie (#PCDATA)>
			<!ELEMENT nazwisko (#PCDATA)>
			<!ELEMENT pesel (#PCDATA)>
			<!ELEMENT data_urodzenia (#PCDATA)>
		<!ELEMENT pracownik (imie, nazwisko, pesel, data_urodzenia)>
			<!ATTLIST pracownik ID_pracownika NMTOKEN #REQUIRED>
			<!ATTLIST pracownik plec (k|m) #IMPLIED>
		<!ELEMENT typ_aktywnosci (aktywnosc, szczegoly?)>
			<!ATTLIST typ_aktywnosci typ ENTITY #REQUIRED>
			<!ELEMENT aktywnosc (#PCDATA)>
			<!ELEMENT szczegoly (#PCDATA)>
		<!ELEMENT projekt (nazwa_projektu)>
			<!ATTLIST projekt ID_projektu NMTOKEN #REQUIRED>
			<!ELEMENT nazwa_projektu (#PCDATA)>
		<!ELEMENT data (#PCDATA)>
		<!ELEMENT czas_trwania (#PCDATA)>
